    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.436.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "recharts": "^2.12.7",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
